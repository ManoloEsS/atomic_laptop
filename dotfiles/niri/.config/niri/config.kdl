// Niri configuration for the Fedora laptop session.
// Machine-specific outputs live in ~/.config/niri/local.kdl (see profiles/laptop/).
include "~/.config/niri/local.kdl"
// Touchpad on/off state lives in ~/.config/niri/touchpad.kdl (toggle-touchpad).
// It MUST be included after the main input block below: pointing-device
// sections are not merged, so the later definition wins wholesale.

input {
    keyboard {
        repeat-rate 40
        repeat-delay 250
        numlock
    }

    touchpad {
        tap
        dwt
        accel-profile "flat"
        scroll-factor 0.4
    }

 mouse {
        // off
        // natural-scroll
        accel-speed 0.1
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // Uncomment this to make the mouse warp to the center of newly focused windows.
    warp-mouse-to-focus

    // Focus windows and outputs automatically when moving the mouse into them.
    // Setting max-scroll-amount="0%" makes it work only on windows already fully on screen.
    focus-follows-mouse max-scroll-amount="0%"
}

// Touchpad state fragment (see top comment): positioned after input so it wins.
include "~/.config/niri/touchpad.kdl"

layout {
    gaps 9
    center-focused-column "never"

    default-column-width { proportion 0.99; }
    preset-column-widths {
        proportion 0.29
        proportion 0.49
        proportion 0.69
        proportion 0.99
    }

    focus-ring {
        width 3
        active-gradient from="#33ccff" to="#00ff99" angle=45
        inactive-color "#414868"
        // active-color "#ffc870"
        // inactive-color "#505050"
        //
        // // Color of the border around windows that request your attention.
        // urgent-color "#9b0000"

    }

    border {
        off
    }
}

// Keep Noctalia as the only shell owner for the bar, launcher, notifications,
// lock screen, idle behavior, wallpaper, and control center.
spawn-at-startup "noctalia"
// spawn-at-startup "~/.config/niri/auto-column-width.py"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

debug {
    // Allow Noctalia notification actions and window activation requests.
    honor-xdg-activation-with-invalid-serial
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    // Niri's defaults are intentionally retained until runtime tuning.
}

blur {
    passes 0
    offset 3
    noise 0.02
    saturation 1.5
}

window-rule {
    match app-id="^com\\.mitchellh\\.ghostty$"  // Matches Ghostty's standard Wayland ID

    background-effect {
        blur true
    }
}

window-rule {
    match app-id="^Alacritty$"  // Matches Alacritty's Wayland app ID (class.general)

    background-effect {
        blur true
    }
}

// Common dialogs and picture-in-picture should not consume a full column.
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 1000 // Hides the cursor after 1 second of inactivity
}


gestures {
    hot-corners {
        off
    }
}


binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Ctrl+C { center-column; }

    // Applications and Noctalia shell controls.
    Mod+Return hotkey-overlay-title="Open a terminal" { spawn "alacritty"; }
    Mod+Shift+Return hotkey-overlay-title="Open Firefox" { spawn "flatpak" "run" "org.mozilla.firefox"; }
    Mod+E hotkey-overlay-title="Open the file manager" { spawn "nautilus" "--new-window"; }
    Mod+Q repeat=false { close-window; }

    // Universal copy/paste/cut, matching Omarchy's shortcuts across apps.
    Mod+C repeat=false hotkey-overlay-title="Universal copy" { spawn "~/.local/bin/universal-clipboard" "copy"; }
    Mod+V repeat=false hotkey-overlay-title="Universal paste" { spawn "~/.local/bin/universal-clipboard" "paste"; }
    Mod+X repeat=false hotkey-overlay-title="Universal cut" { spawn "~/.local/bin/universal-clipboard" "cut"; }
    // Laptop input-device toggle: portable chord plus dedicated
    // hardware keys (On/Off enforce state rather than toggling).
    // Super+Alt+O joins the Super+Alt+* control group (Super+Alt+U
    // applies system updates, so the old Mod+Alt+U chord moved here).
    Super+Alt+O repeat=false hotkey-overlay-title="Toggle touchpad" { spawn "~/.local/bin/toggle-touchpad" "toggle"; }
    XF86TouchpadToggle repeat=false hotkey-overlay-title="Toggle touchpad" { spawn "~/.local/bin/toggle-touchpad" "toggle"; }
    XF86TouchpadOn repeat=false hotkey-overlay-title="Enable touchpad" { spawn "~/.local/bin/toggle-touchpad" "on"; }
    XF86TouchpadOff repeat=false hotkey-overlay-title="Disable touchpad" { spawn "~/.local/bin/toggle-touchpad" "off"; }
    // Lock with noctalia
    Mod+Space hotkey-overlay-title="Open launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+Escape hotkey-overlay-title="Open session options" { spawn-sh "noctalia msg panel-toggle session"; }
    Alt+Tab hotkey-overlay-title="Switch windows" { spawn-sh "noctalia msg window-switcher"; }

    // Focus and move windows in Niri's scrolling-column model.
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    // Mod+Ctrl+J     { move-window-down; }
    // Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    // Alternative commands that move across workspaces when reaching
    // the first or last window in a column.
    // Mod+J     { focus-window-or-workspace-down; }
    // Mod+K     { focus-window-or-workspace-up; }
    Mod+Ctrl+J     { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+K     { move-window-up-or-to-workspace-up; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    // Workspace selection and movement.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+Tab { focus-workspace-previous; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }

    // Niri layout and window state.
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    Mod+Shift+Minus { set-column-width "-10%"; }
    Mod+Shift+Equal { set-column-width "+10%"; }

    Mod+Minus { set-window-height "-10%"; }
    Mod+Equal { set-window-height "+10%"; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+M { maximize-window-to-edges; }

    Mod+Ctrl+F { expand-column-to-available-width; }


    Mod+T { toggle-window-floating; }
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }

    Mod+W { toggle-column-tabbed-display; }

    Mod+Comma { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }

    Mod+BracketLeft { consume-window-into-column; }
    Mod+BracketRight { expel-window-from-column; }

    Mod+O { toggle-overview; }

    // Noctalia media and system controls remain available while locked.
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Increase volume" { spawn-sh "noctalia msg volume-up 2"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Decrease volume" { spawn-sh "noctalia msg volume-down 2"; }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title="Mute volume" { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Mute microphone" { spawn-sh "noctalia msg mic-mute"; }
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Increase brightness" { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Decrease brightness" { spawn-sh "noctalia msg brightness-down"; }
    XF86AudioNext allow-when-locked=true hotkey-overlay-title="Next track" { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title="Previous track" { spawn-sh "noctalia msg media previous"; }
    XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Play or pause media" { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause allow-when-locked=true hotkey-overlay-title="Play or pause media" { spawn-sh "noctalia msg media toggle"; }
    XF86PowerOff allow-when-locked=true hotkey-overlay-title="Open session options" { spawn-sh "noctalia msg panel-toggle session"; }

    Super+Alt+I hotkey-overlay-title="Toggle caffeine mode" { spawn-sh "noctalia msg caffeine-toggle"; }
    Super+Alt+N hotkey-overlay-title="Toggle night light" { spawn-sh "noctalia msg nightlight-toggle"; }
    Super+Alt+L hotkey-overlay-title="Lock session" { spawn-sh "noctalia msg session lock"; }
    Super+Shift+Space hotkey-overlay-title="Toggle bar" { spawn-sh "noctalia msg bar-toggle"; }
    Super+Alt+Space hotkey-overlay-title="Open wallpaper panel" { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Super+Alt+E hotkey-overlay-title="Open emoji picker" { spawn-sh "noctalia msg panel-toggle launcher /emo"; }
    Super+Alt+Q hotkey-overlay-title="Open calculator" { spawn-sh "noctalia msg panel-toggle launcher /calc"; }
    Super+Alt+A hotkey-overlay-title="Open audio controls" { spawn-sh "noctalia msg panel-toggle control-center audio"; }
    Super+Alt+B hotkey-overlay-title="Open Bluetooth controls" { spawn-sh "noctalia msg panel-toggle control-center bluetooth"; }
    Super+Alt+D hotkey-overlay-title="Open display controls" { spawn-sh "noctalia msg panel-toggle control-center monitor"; }
    Super+Alt+M hotkey-overlay-title="Open media controls" { spawn-sh "noctalia msg panel-toggle control-center media"; }
    Super+Alt+P hotkey-overlay-title="Open power controls" { spawn-sh "noctalia msg panel-toggle control-center power"; }
    Super+Alt+T hotkey-overlay-title="Open system controls" { spawn-sh "noctalia msg panel-toggle control-center system"; }
    Super+Alt+U hotkey-overlay-title="Apply system updates" { spawn "alacritty" "-e" "fedora-update"; }
    Super+Alt+V hotkey-overlay-title="Open clipboard history" { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Super+Alt+W hotkey-overlay-title="Open network controls" { spawn-sh "noctalia msg panel-toggle control-center network"; }
    Super+Alt+Shift+S hotkey-overlay-title="Capture screen region" { spawn-sh "noctalia msg screenshot-region"; }
    Super+Ctrl+Comma hotkey-overlay-title="Toggle Do Not Disturb" { spawn-sh "noctalia msg notification-dnd-toggle"; }
    Super+Alt+Comma hotkey-overlay-title="Show latest notification" { spawn-sh "noctalia msg notification-invoke-latest"; }
    Super+Alt+Slash hotkey-overlay-title="Open notifications" { spawn-sh "noctalia msg panel-toggle control-center notifications"; }
    Super+Alt+Period hotkey-overlay-title="Clear active notification" { spawn-sh "noctalia msg notification-clear-active"; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Super+Shift+P { power-off-monitors; }
    Mod+Shift+E { quit; }
}
