# Optional default RDP endpoint. Do not put passwords, tokens, or keys here.
FEDORA_LAPTOP_RDP_HOST=
FEDORA_LAPTOP_RDP_USER=

# NetworkManager connection UUIDs trusted as FedoraWorkstation networks.
# Only include networks you own and trust.
FEDORA_LAPTOP_TRUSTED_CONNECTION_UUIDS=""

# Capture real display identifiers with `niri msg outputs` after logging in.
# Keep hardware-specific Niri output rules out of this sample profile.
